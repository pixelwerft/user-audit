{% import '_includes/forms' as forms %}

{% set groupOptions = [] %}
{% for group in craft.app.userGroups.getAllGroups() %}
  {% set groupOptions = groupOptions|merge([{
    label: group.name,
    value: group.uid,
  }]) %}
{% endfor %}

<h2>{{ 'Access'|t('user-audit') }}</h2>
<p class="light">
  {{ 'Admins always have access to the User Audit viewer. Additionally grant access to selected CP user groups below. If no group is selected the plugin stays admin-only.'|t('user-audit') }}
</p>

{{ forms.checkboxSelectField({
  label: 'Allowed user groups'|t('user-audit'),
  instructions: 'Members of these groups can see the User Audit nav entry and the viewer. Admins always have access regardless of this setting.'|t('user-audit'),
  id: 'allowedUserGroupUids',
  name: 'allowedUserGroupUids',
  options: groupOptions,
  values: settings.allowedUserGroupUids,
  showAllOption: false,
}) }}

<hr>

<h2>{{ 'What gets recorded'|t('user-audit') }}</h2>
<p class="light">
  {{ 'Controls which events are written to the activity log. Changes take effect immediately — existing entries are kept. Custom events from other modules (log() with a custom eventType) are not affected.'|t('user-audit') }}
</p>

{{ forms.lightswitchField({
  label: 'Record control panel events'|t('user-audit'),
  instructions: 'Admin logins via /admin.'|t('user-audit'),
  id: 'recordCpEvents',
  name: 'recordCpEvents',
  on: settings.recordCpEvents,
}) }}

{{ forms.lightswitchField({
  label: 'Record frontend events'|t('user-audit'),
  instructions: 'Logins from the PWA or public site.'|t('user-audit'),
  id: 'recordFrontendEvents',
  name: 'recordFrontendEvents',
  on: settings.recordFrontendEvents,
}) }}

{{ forms.lightswitchField({
  label: 'Record client type (PWA vs. browser)'|t('user-audit'),
  instructions: 'Reads the X-Reest-Client header on login/logout requests and stores pwa or browser. Turn off to keep the column NULL and hide the client filter.'|t('user-audit'),
  id: 'recordClientType',
  name: 'recordClientType',
  on: settings.recordClientType,
}) }}

{{ forms.lightswitchField({
  label: 'Record password changes'|t('user-audit'),
  instructions: 'Logs a password_changed audit row whenever a users password is set, with strength classifications (length ≥ 8, has upper/lower/digit/special). The plaintext password is observed only to compute the booleans — never stored or sent off-instance.'|t('user-audit'),
  id: 'recordPasswordChanges',
  name: 'recordPasswordChanges',
  on: settings.recordPasswordChanges,
}) }}

<hr>

<h2>{{ 'Retention'|t('user-audit') }}</h2>

{{ forms.textField({
  label: 'Retention (days)'|t('user-audit'),
  instructions: 'Entries older than N days are deleted during the purge run. 0 = never delete.'|t('user-audit'),
  id: 'retentionDays',
  name: 'retentionDays',
  type: 'number',
  value: settings.retentionDays,
}) }}

<p class="light">
  {{ 'Manual run:'|t('user-audit') }}
</p>
<pre>./craft user-audit/purge/run
./craft user-audit/purge/run --dry-run=1</pre>

<p class="light">
  {{ 'Recommended cron (every 30 minutes):'|t('user-audit') }}
</p>
<pre>*/30 * * * * cd /path/to/craft && php craft user-audit/purge/run &gt;/dev/null 2&gt;&amp;1</pre>

<hr>

<h2>{{ 'Throttling'|t('user-audit') }}</h2>
<p class="light">
  {{ 'Blocks login requests by IP or email when too many login_failed entries fall within the window. Hitting the limit returns HTTP 429 and creates a login_blocked audit entry.'|t('user-audit') }}
</p>

{{ forms.lightswitchField({
  label: 'Enable throttling'|t('user-audit'),
  id: 'throttlingEnabled',
  name: 'throttlingEnabled',
  on: settings.throttlingEnabled,
}) }}

{{ forms.textField({
  label: 'Failures per IP'|t('user-audit'),
  instructions: 'How many failed logins per IP are allowed within the window. 0 = no IP limit.'|t('user-audit'),
  id: 'failsPerIp',
  name: 'failsPerIp',
  type: 'number',
  value: settings.failsPerIp,
}) }}

{{ forms.textField({
  label: 'Failures per email/login'|t('user-audit'),
  instructions: 'How many failed logins per login name are allowed within the window. 0 = no email limit.'|t('user-audit'),
  id: 'failsPerEmail',
  name: 'failsPerEmail',
  type: 'number',
  value: settings.failsPerEmail,
}) }}

{{ forms.textField({
  label: 'Window (minutes)'|t('user-audit'),
  instructions: 'Sliding window. Older failures outside this range no longer count.'|t('user-audit'),
  id: 'windowMinutes',
  name: 'windowMinutes',
  type: 'number',
  value: settings.windowMinutes,
}) }}

<p class="light">
  {{ 'Manual unblock:'|t('user-audit') }}
</p>
<pre>./craft user-audit/throttle/reset --ip=1.2.3.4
./craft user-audit/throttle/reset --email=foo@bar.ch</pre>

<hr>

<h2>{{ 'New-location alerts'|t('user-audit') }}</h2>
<p class="light">
  {{ 'Sends the user an email when someone logs in from an IP that has not been seen for them within the lookback period. Helps detect compromised accounts early.'|t('user-audit') }}
</p>

{{ forms.lightswitchField({
  label: 'Send new-location emails'|t('user-audit'),
  id: 'newLocationAlertsEnabled',
  name: 'newLocationAlertsEnabled',
  on: settings.newLocationAlertsEnabled,
}) }}

{{ forms.textField({
  label: 'Lookback (days)'|t('user-audit'),
  instructions: 'How far back to look when deciding whether an IP is new. Larger values reduce false positives — but a stolen account will take longer to detect.'|t('user-audit'),
  id: 'newLocationLookbackDays',
  name: 'newLocationLookbackDays',
  type: 'number',
  value: settings.newLocationLookbackDays,
}) }}

<hr>

{# Defaults payload is rendered into a data attribute (rather than a
   global JS var) so the JS stays scoped to this button and the page
   doesn't leak plugin-specific state into the CP namespace. #}
{% set defaultsPayload = {
  retentionDays: defaults.retentionDays,
  recordCpEvents: defaults.recordCpEvents,
  recordFrontendEvents: defaults.recordFrontendEvents,
  recordClientType: defaults.recordClientType,
  recordPasswordChanges: defaults.recordPasswordChanges,
  throttlingEnabled: defaults.throttlingEnabled,
  failsPerIp: defaults.failsPerIp,
  failsPerEmail: defaults.failsPerEmail,
  windowMinutes: defaults.windowMinutes,
  newLocationAlertsEnabled: defaults.newLocationAlertsEnabled,
  newLocationLookbackDays: defaults.newLocationLookbackDays,
  allowedUserGroupUids: defaults.allowedUserGroupUids,
} %}

<div style="margin-top: 1rem;">
  <button
    type="button"
    id="user-audit-reset-defaults"
    class="btn"
    data-defaults="{{ defaultsPayload|json_encode }}"
    data-confirm="{{ 'Reset all fields to defaults? Your changes will only be saved once you click Save.'|t('user-audit') }}"
  >
    {{ 'Reset to defaults'|t('user-audit') }}
  </button>
  <p class="light" style="margin-top: 0.5rem; font-size: 0.8rem; max-width: 48em;">
    {{ 'Fills every field on this page with its built-in default value. Nothing is written to disk — click Save afterwards to persist the reset.'|t('user-audit') }}
  </p>
</div>

{% js %}
(function () {
  var btn = document.getElementById('user-audit-reset-defaults');
  if (!btn) return;

  var defaults;
  try { defaults = JSON.parse(btn.getAttribute('data-defaults') || '{}'); }
  catch (e) { defaults = {}; }

  // Craft wraps settingsHtml in a `namespace` block named "settings",
  // so every input ends up as settings[fieldName]. We scope our
  // lookups to that prefix to avoid collisions with unrelated CP fields.
  function findInput(name) {
    return document.querySelector('[name="settings[' + name + ']"]');
  }
  function findAllInputs(name) {
    return document.querySelectorAll(
      '[name="settings[' + name + ']"], [name="settings[' + name + '][]"]'
    );
  }

  function setText(name, value) {
    var el = findInput(name);
    if (el) el.value = value;
  }

  function setLightswitch(name, on) {
    // Craft lightswitch markup: .lightswitch container with an inner
    // hidden input. Toggling the .on class on the container animates
    // the handle; setting the hidden value persists on submit.
    var hidden = document.querySelector('input[type="hidden"][name="settings[' + name + ']"]');
    if (!hidden) return;
    hidden.value = on ? '1' : '';
    var container = hidden.closest('.lightswitch');
    if (container) container.classList.toggle('on', !!on);
  }

  function setCheckboxGroup(name, values) {
    var arr = Array.isArray(values) ? values : [];
    findAllInputs(name).forEach(function (input) {
      if (input.type === 'checkbox') {
        input.checked = arr.indexOf(input.value) !== -1;
      }
    });
  }

  btn.addEventListener('click', function () {
    var msg = btn.getAttribute('data-confirm');
    if (msg && !window.confirm(msg)) return;

    setText('retentionDays', defaults.retentionDays);
    setText('failsPerIp', defaults.failsPerIp);
    setText('failsPerEmail', defaults.failsPerEmail);
    setText('windowMinutes', defaults.windowMinutes);
    setText('newLocationLookbackDays', defaults.newLocationLookbackDays);

    setLightswitch('recordCpEvents', !!defaults.recordCpEvents);
    setLightswitch('recordFrontendEvents', !!defaults.recordFrontendEvents);
    setLightswitch('recordClientType', !!defaults.recordClientType);
    setLightswitch('recordPasswordChanges', !!defaults.recordPasswordChanges);
    setLightswitch('throttlingEnabled', !!defaults.throttlingEnabled);
    setLightswitch('newLocationAlertsEnabled', !!defaults.newLocationAlertsEnabled);

    setCheckboxGroup('allowedUserGroupUids', defaults.allowedUserGroupUids || []);
  });
})();
{% endjs %}
