{# v2.0: replaced the hand-rolled filter form + table with Crafts
   standard element-index layout. The AuditLog element type defines
   sources, table attributes, sort options, status pills and search;
   `_layouts/elementindex` renders the entire CP UX (sidebar, sticky
   header, ajax pagination, column picker) for free. #}
{% extends '_layouts/elementindex' %}

{% set title = 'User audit logs'|t('user-audit') %}
{% set selectedSubnavItem = 'logs' %}
{% set elementType = 'pixelwerft\\useraudit\\elements\\AuditLog' %}

{% set crumbs = [
  { label: 'User Audit'|t('user-audit'), url: cpUrl('user-audit/logs') }
] %}

{# Sidebar action: jump to plugin settings without leaving the
   element-index. Standard `<header>` actions live to the right of the
   page title in this layout. #}
{% block actionButton %}
  <a href="{{ cpUrl('settings/plugins/user-audit') }}"
     class="btn settings icon"
     title="{{ 'Settings'|t('user-audit') }}">
    {{ 'Settings'|t('user-audit') }}
  </a>
{% endblock %}
